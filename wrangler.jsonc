{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "unfurl-worker",
	"account_id": "44321e1b7fbd29b56b65c1890a3bbee2",
	"compatibility_date": "2026-08-03",
	"main": "src/index.ts",
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "unfurl.willow.rest", "custom_domain": true }],
	"cache": { "enabled": true },
	"ratelimits": [
		{
			"name": "RATE_LIMITS",
			"namespace_id": "1000",
			"simple": {
				"limit": 12,
				"period": 60,
			},
		},
	],
	"observability": {
		"enabled": true,
		"traces": { "enabled": true },
		"head_sampling_rate": 0.3,
	},
}
